# CHRONICLE - Secure Digital Document Management System (PS 26190)
# Copy to .env and change the secrets before any real deployment.

SECRET_KEY=CHANGE_ME_random_64_chars
SECRET_SALT=CHANGE_ME_custody_hmac_salt
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./chronicle.db
VAULT_DIR=./case_vault
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app,*
